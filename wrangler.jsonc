{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloud-claw-final",
  "main": "./src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": true,
  "keep_vars": true,
  "observability": {
    "traces": {
      "enabled": true,
    },
    "logs": {
      "enabled": true,
    },
  },
  "placement": {
    "region": "aws:us-west-2",
  },
  "vars": {
    "WORKER_URL": "https://cloud-claw-final.dl-56e.workers.dev",
    "OPENCLAW_GATEWAY_TOKEN": "cloud-claw",
    "DISCOVERY_WORKER_URL": "https://prospecting-discovery.dl-56e.workers.dev",
    "DISCOVERY_API_SECRET": "production-secret-123",
  },
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  "containers": [
    {
      "name": "cloud-claw-container-final",
      "class_name": "AgentContainer",
      "image": "registry.cloudflare.com/56e8d68c2c46720b0d77df12d63da7e2/cloud-claw-container-final:silent2",
      "rollout_step_percentage": 100,
      "rollout_active_grace_period": 0,
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 4096,
        "disk_mb": 8192,
      },
      "max_instances": 5,
      "constraints": {
        "region": ["wnam"],
      },
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "AgentContainer",
        "name": "AGENT_CONTAINER",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["AgentContainer"],
      "tag": "container",
    },
  ],
}
